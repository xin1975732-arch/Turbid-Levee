   "role": "户房书办，进衙门第五年",
   "intro": "三都井头村人。字写得端正，誊得又快又准。袖袋里有一只褡裢，夹层里攒着几张竹纸，每一张都写着日子。",
   "events": [
    {
     "ch": 1,
     "t": "接手西堤核销册，册上一千三百八十两，旧额七百两；揭开末页，是贴补的"
    },
    {
     "ch": 1,
     "t": "收下老宋的禀帖，盖了“户房收讫”，夹进册子，没往上报"
    },
    {
     "ch": 2,
     "t": "半夜上堤核料石，看见守夜的人被调走"
    },
    {
     "ch": 3,
     "t": "从水里捞出验收簿：验收人一栏空着，页子被拆；天亮时它不见了"
    },
    {
     "ch": 4,
     "t": "点夫一百四十二名；险报交驿，驿簿有记；三更，在城楼上听见中段决口"
    },
    {
     "ch": 5,
     "t": "吴县丞问那张禀帖：收了，为何不报"
    },
    {
     "ch": 6,
     "t": "在赈册末尾私补东村五户；第二日被划掉，旁边两个字：越例"
    },
    {
     "ch": 7,
     "t": "核三都的田，想起十六岁替父亲写的那张“伏乞垂怜”"
    },
    {
     "ch": 8,
     "t": "替东村五户求来保结；把邱老汉的呈子压在赈册底下"
    },
    {
     "ch": 9,
     "t": "吏役册上自己那一页：生员沈默，字子鸣。他看了一眼，翻过去了"
    },
    {
     "ch": 9,
     "t": "从税册和贴补的笔迹里，认出余司吏的手"
    },
    {
     "ch": 12,
     "t": "翻出三十五年那张临时核销单，誊录的是他自己"
    },
    {
     "ch": 13,
     "t": "写了一夜的呈子，听了余司吏的话，锁进床底下的木匣"
    },
    {
     "ch": 15,
     "t": "把三十四户张家佃户写成无主贫户；把宋家的田界批了“俟秋后会勘”"
    },
    {
     "ch": 16,
     "t": "三更打开余司吏的柜子，誊下柜里的真话"
    },
    {
     "ch": 17,
     "t": "八月十五夜写成呈文，第二日交驿，寄往按察司"
    },
    {
     "ch": 19,
     "t": "原呈退回；写下具结，画了押"
    },
    {
     "ch": 20,
     "t": "教新来的小顾：批语栏写“照册转录”"
    }
   ],
