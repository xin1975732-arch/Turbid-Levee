{
  "eras": [
    { "id": "old", "name": "旧账" },
    { "id": "now", "name": "嘉靖四十年" }
  ],
  "events": [
    { "k": "1543-03", "era": "old", "d": "嘉靖二十二年 三月", "t": "同一天进衙门", "s": "生员余某、生员孙某，同日充户房书手。都是进过学的。", "ch": 9, "who": ["yusili", "sunshuban"] },
    { "k": "1547-06", "era": "old", "d": "嘉靖二十六年 夏", "t": "伏乞垂怜", "s": "西乡涝了一个多月，粮照交。十六岁的沈默替父亲写呈子求减，誊了三遍。等了一个冬天，家里卖了牛，第二年卖了井边那块田。", "ch": 7, "who": ["shenmo"] },
    { "k": "1547-07", "era": "old", "d": "嘉靖二十六年 七月", "t": "孙某认之", "s": "西乡二都一户税册减半。吏役册上记的是孙书办擅改，杖二十，永不升补。字是台阁体。", "ch": 9, "who": ["sunshuban", "yusili"] },
    { "k": "1548", "era": "old", "d": "嘉靖二十七年", "t": "升司吏", "s": "余某升户房司吏。", "ch": 9, "who": ["yusili"] },
    { "k": "1556-03", "era": "old", "d": "嘉靖三十五年 三月", "t": "充户房书手", "s": "生员沈默，字子鸣，充户房书手。是余司吏荐进来的，说户房缺一个字写得端正的人。", "ch": 9, "who": ["shenmo", "yusili"] },
    { "k": "1556-07-09", "era": "old", "d": "嘉靖三十五年 七月初九", "t": "此事不必入册", "s": "西堤中段塌了一段，连夜抢住。临时核销单：共银一千三百八十两。誊录，书手沈默。", "ch": 12, "who": ["shenmo", "yusili"] },
    { "k": "1560-02", "era": "old", "d": "嘉靖三十九年 二月", "t": "中段修竣", "s": "西堤中段补修一段，银三百六十两，修竣。验收另存，戌字七号。", "ch": 3, "who": [] },
    { "k": "1560-12-19", "era": "old", "d": "嘉靖三十九年 腊月十九", "t": "未敢验收", "s": "孙书办往中段验料：册载七百二十方，实到四百二十方。他不肯画押，回来问余司吏：账册与堤，先信哪个。", "ch": 16, "who": ["sunshuban", "yusili"] },

    { "k": "1561-05-07", "era": "now", "d": "五月初七", "t": "照府核数造册", "s": "县丞口谕：西堤核销照一千三百八十两造册。末页贴补，册首孙某的名字刮去。", "ch": 16, "who": ["wuxiancheng", "yusili"] },
    { "k": "1561-05-28", "era": "now", "d": "五月廿八", "t": "册已缴销", "s": "戌字七号，西堤中段验收簿，登缴销。", "ch": 3, "who": [] },
    { "k": "1561-06-10", "era": "now", "d": "六月初十", "t": "接案", "s": "沈默在孙书办留下的案子上，接过西堤核销册。笔筒里一支笔没洗。", "ch": 1, "who": ["shenmo"] },
    { "k": "1561-06-12a", "era": "now", "d": "六月十二", "t": "差六百八十两", "s": "册载一千三百八十两，存留额七百两。老宋递来禀帖，户房收讫。夜里，沈默挑开末页，底下是“柒佰两”。", "ch": 1, "who": ["shenmo", "laozhou", "ayun", "yusili"] },
    { "k": "1561-06-12b", "era": "now", "d": "六月十二 夜", "t": "堤上撤人", "s": "吴县丞天没黑骑马去了府里。一更，冯四“奉县丞口谕”出城调夫；二更，沈默上堤，看见守夜的人被调走。", "ch": 2, "who": ["shenmo", "wanglaoshi", "fengsi", "wuxiancheng"] },
    { "k": "1561-06-13a", "era": "now", "d": "六月十三 凌晨", "t": "库房漫水", "s": "沈默从水里捞出验收簿，搁到最上一层。天亮时，它不见了。", "ch": 3, "who": ["shenmo", "yusili"] },
    { "k": "1561-06-13b", "era": "now", "d": "六月十三 白日", "t": "点夫", "s": "西堤点夫一百四十二名。中段只剩九个人，水离竿头的红，只差一道。", "ch": 4, "who": ["shenmo", "zhengdianshi", "laozhou", "wanglaoshi"] },
    { "k": "1561-06-13c", "era": "now", "d": "六月十三 一更二点", "t": "险报交驿", "s": "郑典史的险报送到驿站。催粮牌先走，险报压在桌上，驿簿上记了一笔。", "ch": 4, "who": ["shenmo", "linyicheng"] },
    { "k": "1561-06-13d", "era": "now", "d": "六月十三 三更", "t": "中段决口", "s": "二更，守夫被叫去东埠头扛粮。三更，一声闷响。水到城墙第三块砖，停了。", "ch": 4, "who": ["shenmo", "wanglaoshi", "fengsi"] },
    { "k": "1561-06-14", "era": "now", "d": "六月十四 巳时", "t": "城里一滴水也没进", "s": "城门不开，粥抬出去。吴县丞从东门回城，先问城里进水没有。", "ch": 5, "who": ["wuxiancheng", "zhengdianshi"] },
    { "k": "1561-06-15", "era": "now", "d": "六月十五", "t": "未受灾", "s": "东村十七户，屋塌十五，无存二。草册上，宋家一行写着：未受灾。", "ch": 5, "who": ["shenmo", "laozhou", "ayun"] },
    { "k": "1561-06-16", "era": "now", "d": "决口后第三日", "t": "收了，为何不报", "s": "王老实被带去问话。傍晚，吴县丞把老宋的禀帖收进了自己的抽屉。", "ch": 5, "who": ["wanglaoshi", "wuxiancheng", "shenmo"] },
    { "k": "1561-06-20", "era": "now", "d": "六月二十", "t": "凭册领米", "s": "粥厂立牌。夜里，沈默在赈册末尾补上东村五户；第二日，被划掉，旁注：越例。", "ch": 6, "who": ["shenmo", "zhengdianshi", "yusili", "ayun"] },
    { "k": "1561-06-23", "era": "now", "d": "又过三日", "t": "土地庙", "s": "核三都的田。老宋说：你那时候，不是这样说话的。", "ch": 7, "who": ["shenmo", "laozhou", "laotongsheng"] },
    { "k": "1561-06-26", "era": "now", "d": "张家粥第十二日", "t": "一碗粥", "s": "张家改施粥为借米。东村五户取了保结；邱老汉的呈子压在赈册底下。", "ch": 8, "who": ["zhangyuanwai", "shenmo", "qiulaohan", "qiusunzi", "ayun"] },
    { "k": "1561-06-29", "era": "now", "d": "六月二十九", "t": "殁于土地庙", "s": "邱老汉的名字，头一回上了这个县的册子，是殓埋册。", "ch": 8, "who": ["qiulaohan", "shenmo"] },
    { "k": "1561-07-03", "era": "now", "d": "七月初三", "t": "取铺盖", "s": "孙书办的儿子来取铺盖。吏役册上，余某、孙某同日进衙门。", "ch": 9, "who": ["sunjiahaizi", "shenmo", "yusili"] },
    { "k": "1561-07-05", "era": "now", "d": "七月初五", "t": "奉县丞口谕", "s": "工食单、西门门簿上，都是这五个字。吴县丞说：我没有交代过。照样落了款。", "ch": 10, "who": ["shenmo", "zhengdianshi", "wuxiancheng", "wanglaoshi"] },
    { "k": "1561-07-07", "era": "now", "d": "七月初七", "t": "冯四溺毙", "s": "告假回乡，行至二都溪口，失足。怀里一张泡烂的纸。", "ch": 10, "who": ["fengsi"] },
    { "k": "1561-07-08", "era": "now", "d": "七月", "t": "不必入册", "s": "冯四的纸上剩下几个字。沈默想起，这句话他誊过。", "ch": 11, "who": ["shenmo", "fengsi", "yusili"] },
    { "k": "1561-07-10", "era": "now", "d": "七月", "t": "旧笔", "s": "库房里翻出三十五年的临时核销单，一千三百八十两，一两不多，一两不少。", "ch": 12, "who": ["shenmo", "yusili"] },
    { "k": "1561-07-12", "era": "now", "d": "七月", "t": "木匣", "s": "写了一夜的呈子，没有递，锁进床底下的旧木匣。第七日，府文到，西堤册籍封存。", "ch": 13, "who": ["shenmo", "yusili", "zhengdianshi", "heshi"] },
    { "k": "1561-07-25", "era": "now", "d": "七月下旬", "t": "三百石", "s": "官仓见底。张员外捐米三百石，佃户归东家自赈。廊下，他提起宋家那张田界帖子。", "ch": 14, "who": ["zhangyuanwai", "wuxiancheng", "shenmo"] },
    { "k": "1561-07-28", "era": "now", "d": "三日后", "t": "无主贫户", "s": "三十四户写进赈册；宋家的田界批了“俟秋后会勘”。船单抄件：四百二十方。余司吏留下一把钥匙。", "ch": 15, "who": ["shenmo", "qiusunzi", "ayun", "yusili", "zhangyuanwai"] },
    { "k": "1561-07-29", "era": "now", "d": "当夜三更", "t": "钥匙", "s": "沈默打开司吏的柜子，一年一捆，三十年的真话。五更，余司吏把柜子的事揽到自己身上。", "ch": 16, "who": ["shenmo", "yusili", "zhengdianshi", "sunshuban"] },
    { "k": "1561-08-15", "era": "now", "d": "八月十五 夜", "t": "据实陈明", "s": "可证之事五条，未能证实之事四条。那一叠誊来的竹纸，放回了木匣。", "ch": 17, "who": ["shenmo", "heshi"] },
    { "k": "1561-08-16", "era": "now", "d": "八月十六", "t": "寄出", "s": "阿芸说出六月十二夜看见的人，不肯画押。夜里，祝驿丞把私书装进县里的公文袋，两封都记。", "ch": 17, "who": ["shenmo", "ayun", "linyicheng", "zhengdianshi", "wuxiancheng"] },
    { "k": "1561-08-30", "era": "now", "d": "八月底", "t": "重造鱼鳞册", "s": "着书办沈默专办。宋家那一条界，照现界描下来，往宋家那边挪了二尺。", "ch": 18, "who": ["shenmo", "wuxiancheng"] },
    { "k": "1561-09-03", "era": "now", "d": "九月初", "t": "借米二石", "s": "老宋来税契：田一亩押与张宅。“先把今年过了。”", "ch": 18, "who": ["laozhou", "shenmo"] },
    { "k": "1561-09-08", "era": "now", "d": "九月初八 夜", "t": "灶边", "s": "省里的札付淋湿了，祝驿丞在灶边烘，火光从封套背后透过来。", "ch": 18, "who": ["linyicheng"] },
    { "k": "1561-09-10", "era": "now", "d": "九月初十 夜", "t": "孙书办没了", "s": "咳了一夜，天亮前睡着了，就没醒。", "ch": 19, "who": ["sunshuban"] },
    { "k": "1561-09-15", "era": "now", "d": "九月十五", "t": "批回", "s": "原呈发回该县，照常办理。沈默写下具结。第二日，王老实挨了二十板，余司吏回了户房。", "ch": 19, "who": ["shenmo", "wuxiancheng", "wanglaoshi", "yusili", "sunjiahaizi"] },
    { "k": "1561-11-01", "era": "now", "d": "十一月初一", "t": "照例", "s": "头一场霜。小顾坐到靠里那张案子后头。傍晚，一张三文钱的帖子，压在了账册底下。", "ch": 20, "who": ["shenmo", "xiaolu", "yusili", "wanglaoshi", "ayun", "ahe"] }
  ]
}
